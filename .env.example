# VideoForge server configuration — copy to .env and edit.
# This file contains placeholders only. Never commit real values.

# API server
VF_PORT=3001
VF_HOST=127.0.0.1
VF_DATA_DIR=./data
VF_MAX_UPLOAD_BYTES=20971520
VF_RETENTION_DAYS=30
VF_MAX_CONCURRENT_JOBS=2

# Generation backend (none by default — honest "not configured" until set)
# Supported: comfyui, none
VF_PROVIDER=none

# --- ComfyUI (only used when VF_PROVIDER=comfyui) ---
VF_COMFY_URL=http://127.0.0.1:8188
VF_COMFY_TEXT_WORKFLOW=./workflows/text-to-video.example.json
# VF_COMFY_IMAGE_WORKFLOW=./workflows/image-to-video.example.json
VF_COMFY_PROMPT_NODE=6
# VF_COMFY_NEGATIVE_NODE=
# VF_COMFY_DIMENSION_NODE=
# VF_COMFY_SEED_NODE=
# VF_COMFY_IMAGE_NODE=
VF_COMFY_OUTPUT_NODE=VHS_VideoCombine
